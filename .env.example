# Copy to .env (local) or set in the host's environment settings.
# All are public: they end up in the browser bundle. Never put secrets here.

# Contact form adapter: "mock" (default, sends NOTHING), "formspree" (chosen)
# or "http" (generic JSON POST). The build warns while it is "mock".
# Production (the preview and the final host) uses:
#   PUBLIC_FORM_ADAPTER=formspree
#   PUBLIC_FORM_ENDPOINT=https://formspree.io/f/maengwnd
# Keep local development on mock, so testing doesn't send real enquiries.
PUBLIC_FORM_ADAPTER=mock

# With PUBLIC_FORM_ADAPTER=formspree or http, the form POSTs JSON here.
PUBLIC_FORM_ENDPOINT=

# When set, the Connect page shows a booking embed for this URL.
# Adding one also means updating the Privacy Policy (a new third party).
PUBLIC_BOOKING_URL=
