---
import Logo from './Logo.astro';
import MotifLink from './motif/MotifLink.astro';
import { mainNav, site } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === href;
---

<header class="sticky top-0 z-40 border-b border-line bg-bg">
  <div class="container-site flex h-(--header-h) items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 sm:gap-3" data-menu-inert>
      <Logo class="h-9 w-auto shrink-0 md:h-11" />
      <span class="font-display text-body leading-tight font-medium sm:text-lead">{site.name}</span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {
          mainNav.map((item) => (
            <li>
              <MotifLink href={item.href} current={isCurrent(item.href)} class="py-2">
                {item.label}
              </MotifLink>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1 md:ml-6">
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full hover:bg-line"
        aria-pressed="false"
        data-theme-toggle
        data-requires-js
        data-menu-trap
      >
        <span class="sr-only">Dark mode</span>
        <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
        </svg>
      </button>

      <button
        type="button"
        class="group grid size-11 place-items-center rounded-full hover:bg-line md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-button
        data-menu-trap
        data-requires-js
      >
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
          <g class="group-aria-expanded:hidden" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <line x1="4" y1="9" x2="20" y2="9"></line>
            <line x1="4" y1="15" x2="20" y2="15"></line>
          </g>
          <g class="hidden group-aria-expanded:block" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="18" y1="6" x2="6" y2="18"></line>
          </g>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu invisible fixed inset-x-0 top-(--header-h) bottom-0 -translate-y-2 overflow-y-auto bg-bg opacity-0 data-open:visible data-open:translate-y-0 data-open:opacity-100 md:hidden"
    data-menu-panel
    data-menu-trap
  >
    <nav aria-label="Main" class="container-site pt-6 pb-12">
      <ul>
        {
          mainNav.map((item) => (
            <li class="border-b border-line">
              <MotifLink href={item.href} current={isCurrent(item.href)} unit={2} class="block py-4 font-display text-h2">
                {item.label}
              </MotifLink>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /*
   * Opening: visible at once (so focus can move into the panel), then fade in.
   * Closing: fade out, then hide, which also removes it from the tab order.
   */
  .mobile-menu {
    transition:
      opacity 200ms ease-out,
      translate 200ms ease-out,
      visibility 0s linear 200ms;
  }

  .mobile-menu[data-open] {
    transition:
      opacity 200ms ease-out,
      translate 200ms ease-out,
      visibility 0s;
  }
</style>

<script>
  import { init as initTheme } from '../lib/theme';
  import { init as initMenu } from '../lib/menu';

  initTheme();
  initMenu();
</script>
