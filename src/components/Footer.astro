---
import ContactDetails from './ContactDetails.astro';
import Logo from './Logo.astro';
import MotifLink from './motif/MotifLink.astro';
import SocialLinks from './SocialLinks.astro';
import { mainNav, site } from '../data/site';
import { pagePath, url } from '../lib/url';

const current = pagePath(Astro.url.pathname);
const isCurrent = (href: string) => current === href;
const year = new Date().getFullYear();
---

<footer class="border-t border-line" data-menu-inert>
  <div class="container-site grid-site gap-y-10 py-12 md:py-16">
    <div class="col-span-4 md:col-span-8 lg:col-span-4">
      <a href={url('/')} class="inline-flex items-center gap-3">
        <Logo class="h-12 w-auto" />
        <span class="font-display text-h3 font-medium">{site.name}</span>
      </a>
    </div>

    <nav aria-labelledby="footer-pages" class="col-span-2 md:col-span-2 lg:col-span-2">
      <h2 id="footer-pages" class="font-body text-small font-normal text-muted">Pages</h2>
      <ul class="mt-3 space-y-4">
        {
          mainNav.map((item) => (
            <li>
              <MotifLink href={url(item.href)} current={isCurrent(item.href)}>
                {item.label}
              </MotifLink>
            </li>
          ))
        }
        <li>
          <MotifLink href={url('/privacy')} current={isCurrent('/privacy')}>
            Privacy Policy
          </MotifLink>
        </li>
        <li>
          <MotifLink href={url('/terms')} current={isCurrent('/terms')}>
            Terms of Service
          </MotifLink>
        </li>
      </ul>
    </nav>

    <div class="col-span-4 md:col-span-4 lg:col-span-4">
      <h2 class="font-body text-small font-normal text-muted">Contact</h2>
      <ContactDetails class="mt-3" />
    </div>

    <div class="col-span-4 md:col-span-2 lg:col-span-2">
      <h2 class="font-body text-small font-normal text-muted">Social</h2>
      <SocialLinks class="mt-2" />
    </div>
  </div>

  <div class="container-site">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line py-6 text-small text-muted">
      <p>© {year} {site.name}</p>
      <div class="flex gap-6">
        <a href={url('/privacy')} class="link">Privacy Policy</a>
        <a href={url('/terms')} class="link">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
