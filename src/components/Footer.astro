---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { isTbc, mainNav, site } from '../data/site';

const { email, phone, address } = site.contact;
const year = new Date().getFullYear();
---

<footer class="mt-section border-t border-line" data-menu-inert>
  <div class="container-site grid-site gap-y-10 py-12 md:py-16">
    <div class="col-span-4 md:col-span-8 lg:col-span-4">
      <a href="/" class="inline-flex items-center gap-3">
        <Logo class="h-12 w-auto" />
        <span class="font-display text-h3 font-medium">{site.name}</span>
      </a>
    </div>

    <nav aria-labelledby="footer-pages" class="col-span-2 md:col-span-2 lg:col-span-2">
      <h2 id="footer-pages" class="font-body text-small font-normal text-muted">Pages</h2>
      <ul class="mt-3 space-y-2">
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} class="link">
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="/privacy" class="link">Privacy Policy</a></li>
      </ul>
    </nav>

    <div class="col-span-4 md:col-span-4 lg:col-span-4">
      <h2 class="font-body text-small font-normal text-muted">Contact</h2>
      <address class="not-italic">
        <ul class="mt-3 space-y-3">
          <li class="flex items-start gap-3">
            <Icon name="email" class="mt-[0.3em] size-4 shrink-0 text-accent" />
            <a href={`mailto:${email}`} class="link"><span class="sr-only">Email: </span>{email}</a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="phone" class="mt-[0.3em] size-4 shrink-0 text-accent" />
            <a href={`tel:${phone.replace(/\s/g, '')}`} class="link"><span class="sr-only">Phone: </span>{phone}</a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="location" class="mt-[0.3em] size-4 shrink-0 text-accent" />
            <span><span class="sr-only">Address: </span>{address}</span>
          </li>
        </ul>
      </address>
    </div>

    <div class="col-span-4 md:col-span-2 lg:col-span-2">
      <h2 class="font-body text-small font-normal text-muted">Social</h2>
      <ul class="mt-2 -ml-3 flex gap-1">
        {
          site.social.map(({ network, label, href }) => (
            <li>
              {isTbc(href) ? (
                // Profile URL not supplied yet: shown, but not a link.
                <span class="grid size-11 place-items-center" title={`${label}: link to come`}>
                  <Icon name={network} label={`${label} (link to come)`} class="size-5" />
                </span>
              ) : (
                <a href={href} class="grid size-11 place-items-center rounded-full hover:bg-line" rel="me noopener">
                  <Icon name={network} label={label} class="size-5" />
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-site">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line py-6 text-small text-muted">
      <p>© {year} {site.name}</p>
      <a href="/privacy" class="link">Privacy Policy</a>
    </div>
  </div>
</footer>
