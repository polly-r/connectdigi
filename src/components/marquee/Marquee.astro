---
/**
 * Continuous horizontal marquee. One implementation for the services ticker,
 * the client logo strip and the CTA band. Behaviour: ./marquee.ts.
 * Spec: CLAUDE.md "Marquee component".
 *
 * Children are MarqueeItem elements, rendered once as a real list. The script
 * clones the set (aria-hidden + inert) to fill the width; without JS, or with
 * reduced motion, the single set shows as a static wrapped row.
 */
interface Props {
  /** Accessible name for the list, also used in the pause button's name. */
  label: string;
  /** Pace in pixels per second, independent of content width. */
  speed?: number;
  /** Pace below the md breakpoint. Defaults to 65% of `speed`. */
  mobileSpeed?: number;
  direction?: 'left' | 'right';
  pauseOnHover?: boolean;
  /** Stay paused until first scrolled into view. */
  startOnView?: boolean;
  /** Space after every item, as a CSS length. */
  gap?: string;
  /** Visible pause/play button (WCAG 2.2.2). */
  showControl?: boolean;
  /** Makes the whole strip one link (CTA band); the moving text is then hidden from assistive tech. */
  href?: string;
  /** Accessible name for the link. Required with `href`. */
  linkLabel?: string;
  class?: string;
}

const {
  label,
  speed = 50,
  mobileSpeed = Math.round(speed * 0.65),
  direction = 'left',
  pauseOnHover = true,
  startOnView = false,
  gap = '2.5rem',
  showControl = true,
  href,
  linkLabel,
  class: className,
} = Astro.props;

if (href && !linkLabel) throw new Error(`Marquee "${label}": \`linkLabel\` is required with \`href\`.`);
---

<div
  class:list={['marquee', className]}
  style={`--marquee-gap: ${gap}`}
  data-marquee
  data-label={label}
  data-speed={speed}
  data-mobile-speed={mobileSpeed}
  data-direction={direction}
  data-pause-on-hover={pauseOnHover ? '' : undefined}
  data-start-on-view={startOnView ? '' : undefined}
>
  <div class="marquee-viewport" data-marquee-viewport>
    <div class="marquee-track" data-marquee-track>
      <ul class="marquee-set" aria-label={href ? undefined : label} aria-hidden={href ? 'true' : undefined} data-marquee-set>
        <slot />
      </ul>
    </div>
    {href && <a href={href} class="marquee-link" aria-label={linkLabel} />}
  </div>

  {
    showControl && (
      <button
        type="button"
        class="marquee-control group grid size-11 shrink-0 place-items-center rounded-full border border-control hover:bg-line"
        data-marquee-control
        data-state="playing"
        data-requires-js
      >
        <span class="sr-only" data-marquee-control-text>
          Pause {label}
        </span>
        <svg viewBox="0 0 16 16" class="size-4 group-data-[state=paused]:hidden" aria-hidden="true" focusable="false">
          <rect x="3.5" y="2.5" width="3" height="11" rx="0.5" fill="currentColor" />
          <rect x="9.5" y="2.5" width="3" height="11" rx="0.5" fill="currentColor" />
        </svg>
        <svg viewBox="0 0 16 16" class="hidden size-4 group-data-[state=paused]:block" aria-hidden="true" focusable="false">
          <path d="M4.5 2.5v11l9-5.5z" fill="currentColor" />
        </svg>
      </button>
    )
  }
</div>

<style is:global>
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .marquee {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .marquee-viewport {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
  }

  /* Static fallback (no JS, reduced motion): the single set wraps. */
  .marquee-set {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marquee-item {
    flex: none;
    padding-inline-end: var(--marquee-gap);
  }

  /* With JS and motion allowed, lay out in one line from the start (no shift on init). */
  @media (prefers-reduced-motion: no-preference) {
    html.js .marquee-set {
      flex: none;
      flex-wrap: nowrap;
    }
  }

  /*
   * Running. The seam pad (< 1px, set by the script) rounds each set up to a
   * whole pixel, so the loop point lands on the same sub-pixel phase as the
   * start and text renders identically there.
   */
  .marquee[data-ready] .marquee-track {
    width: max-content;
    animation: marquee-scroll var(--marquee-duration) linear infinite;
    will-change: transform;
  }

  .marquee[data-ready] .marquee-set {
    padding-inline-end: var(--marquee-seam-pad, 0px);
  }

  .marquee[data-ready][data-direction='right'] .marquee-track {
    animation-direction: reverse;
  }

  .marquee[data-paused] .marquee-track,
  .marquee-viewport:focus-within .marquee-track {
    animation-play-state: paused;
  }

  @media (hover: hover) {
    .marquee[data-pause-on-hover] .marquee-viewport:hover .marquee-track {
      animation-play-state: paused;
    }
  }

  /* CTA band: one link over the whole strip. */
  .marquee-link {
    position: absolute;
    inset: 0;
    border-radius: 2px;
  }

  .marquee-link:focus-visible {
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none !important;
    }

    .marquee-control {
      display: none;
    }
  }
</style>

<script>
  import { init } from './marquee';

  init();
</script>
