---
/**
 * Navigation link with the node-motif hover (CSS only, transform-based):
 * a ring at the start of the text, then a connector draws under it to a
 * solid node. Triggers: hover (mouse devices only) and keyboard focus; the
 * current page (`current`) shows it drawn and holds it.
 *
 * The motif sits under the text only, so the link itself can be a wide block
 * (pass layout classes via `class`). Sizes follow src/lib/node-motif.ts at
 * `unit` px per connector width. The motif is accent; the text stays
 * foreground (dark-mode contrast rule).
 *
 * For navigation lists only. Links inside running text keep the plain
 * underline (`link` utility) so they're recognisable at rest.
 */
import { NODE_RADIUS, ringGeometry } from '../../lib/node-motif';

interface Props {
  href: string;
  current?: boolean;
  /** px per connector width. */
  unit?: number;
  class?: string;
}

const { href, current = false, unit = 1.5, class: className } = Astro.props;

const ring = ringGeometry('l');
const ringR = ring.mid * unit;
const ringBand = ring.band * unit;
const solidR = NODE_RADIUS.m * unit;
const height = Math.ceil(ring.outer * unit * 2 + 2);
const cy = height / 2;
---

<a href={href} aria-current={current ? 'page' : undefined} class:list={['ml', className]}>
  <span class="ml-text">
    <slot />
    <svg class="ml-net" height={height} style={`bottom: ${-height / 2 - 2}px`} aria-hidden="true" focusable="false">
      <line x1="0" y1={cy} x2="100%" y2={cy} stroke-width={unit} class="ml-part ml-link" />
      <circle cx="0" cy={cy} r={ringR} stroke-width={ringBand} class="ml-part ml-ring" />
      <circle cx="100%" cy={cy} r={solidR} class="ml-part ml-end" />
    </svg>
  </span>
</a>

<style>
  .ml-text {
    position: relative;
    display: inline-block;
  }

  .ml-net {
    position: absolute;
    left: 0;
    width: 100%;
    overflow: visible;
    pointer-events: none;
    color: var(--color-accent);
  }

  .ml-link {
    stroke: currentColor;
  }

  .ml-ring {
    fill: var(--nn-hole, var(--color-bg));
    stroke: currentColor;
  }

  .ml-end {
    fill: currentColor;
  }

  /* Resting state: hidden. Leaving: everything retracts together, quickly. */
  .ml-part {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    transition: transform 150ms ease-in;
  }

  .ml-link {
    transform-origin: left center;
    transform: scaleX(0);
  }

  /* Entering: ring, then the connector draws, then the end node. */
  @media (hover: hover) {
    .ml:hover .ml-part {
      transform: none;
      transition: transform 180ms ease-out;
    }

    .ml:hover .ml-link {
      transition: transform 260ms 60ms ease-out;
    }

    .ml:hover .ml-end {
      transition: transform 180ms 260ms ease-out;
    }
  }

  .ml:focus-visible .ml-part {
    transform: none;
    transition: transform 180ms ease-out;
  }

  .ml:focus-visible .ml-link {
    transition: transform 260ms 60ms ease-out;
  }

  .ml:focus-visible .ml-end {
    transition: transform 180ms 260ms ease-out;
  }

  /* Current page: drawn, no transition. */
  .ml[aria-current='page'] .ml-part {
    transform: none;
    transition: none;
  }
</style>
