---
/**
 * Per-page <title>, description, canonical URL and social tags.
 * The canonical URL is built from `site` in astro.config (SITE_URL), with a
 * trailing slash to match the directory-style build and the sitemap.
 */
import { site } from '../data/site';

interface Props {
  /** Page name; omitted on Home, which uses the site name alone. */
  title?: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_ZA" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
