---
/**
 * Closing call to action. Defaults are Home's copy (src/data/home.ts, draft);
 * other pages (Pricing) pass their own.
 */
import MotifButton from '../motif/MotifButton.astro';
import { closingCta } from '../../data/home';
import { url } from '../../lib/url';

interface Props {
  title?: string;
  text?: string;
  label?: string;
  /** Site path, passed through url(). */
  href?: string;
}

const {
  title = closingCta.title,
  text = closingCta.text,
  label = 'Get a free consultation',
  href = '/connect',
} = Astro.props;
---

<section class="container-site pb-section" aria-labelledby="closing-cta-title" data-reveal>
  <div class="grid-site items-end gap-y-8">
    <div class="col-span-4 md:col-span-5 lg:col-span-8">
      <h2 id="closing-cta-title" class="max-w-[16ch] text-h1">{title}</h2>
      <p class="mt-6 max-w-[44ch] text-lead text-muted">{text}</p>
    </div>
    <div class="col-span-4 md:col-span-3 md:justify-self-end lg:col-span-4">
      <MotifButton href={url(href)}>{label}</MotifButton>
    </div>
  </div>
</section>
