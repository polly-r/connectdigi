---
/**
 * Stats row. Values are labelled placeholders until real numbers are
 * supplied (src/data/home.ts). A numeric value ("120+", "98%") counts up once
 * on first view (./stats.ts); screen readers get only the final value.
 * Placeholders like "[STAT 1]" are not numeric and show as-is.
 */
import { NUMERIC_STAT, stats } from '../../data/home';
---

<section class="container-site pb-section" aria-labelledby="stats-title" data-reveal>
  <h2 id="stats-title" class="font-body text-small font-normal text-muted">In numbers</h2>
  <dl class="mt-8 grid grid-cols-2 gap-x-gutter gap-y-10 lg:grid-cols-4">
    {
      stats.map(({ value, label }) => {
        const numeric = NUMERIC_STAT.test(value);
        return (
          <div class="flex flex-col-reverse gap-2 border-t border-line pt-6">
            <dt class="text-small text-muted">{label}</dt>
            <dd class="font-display text-h1">
              {numeric ? (
                <>
                  <span aria-hidden="true" data-count-to={value}>
                    {value}
                  </span>
                  <span class="sr-only">{value}</span>
                </>
              ) : (
                value
              )}
            </dd>
          </div>
        );
      })
    }
  </dl>
</section>
