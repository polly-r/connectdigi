---
/**
 * Home "Common questions": a few FAQ questions as links to their answers on
 * /faq (no disclosure here: Home's interaction budget is full).
 */
import MotifLink from '../motif/MotifLink.astro';
import { featuredFaqs } from '../../data/home';
import { faqGroups } from '../../data/faq';
import { url } from '../../lib/url';

const all = faqGroups.flatMap((group) => group.items);
const questions = featuredFaqs.map((id) => {
  const item = all.find((faq) => faq.id === id);
  if (!item) throw new Error(`featuredFaqs: no FAQ with id "${id}" in src/data/faq.ts`);
  return item;
});
---

<section class="container-site pb-section" aria-labelledby="home-faq-title" data-reveal>
  <div class="grid-site gap-y-8">
    <h2 id="home-faq-title" class="col-span-4 max-w-[12ch] text-h2 md:col-span-8 lg:col-span-4">Common questions</h2>
    <div class="col-span-4 md:col-span-8 lg:col-span-7 lg:col-start-6">
      <ul class="border-b border-line">
        {
          questions.map((item) => (
            <li class="border-t border-line py-5 md:py-6">
              <MotifLink href={url(`/faq#${item.id}`)} unit={2} class="font-display text-h3">
                {item.question}
              </MotifLink>
            </li>
          ))
        }
      </ul>
      <p class="mt-8">
        <MotifLink href={url('/faq')}>All questions and answers</MotifLink>
      </p>
    </div>
  </div>
</section>
