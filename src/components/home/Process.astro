---
/**
 * Home "How we work": the five project steps, matching the FAQ's process
 * answer. Copy: src/data/home.ts (draft).
 */
import { process } from '../../data/home';
---

<section class="container-site pb-section" aria-labelledby="process-title" data-reveal>
  <h2 id="process-title" class="text-h2">{process.title}</h2>
  <ol class="mt-10 grid gap-x-gutter gap-y-10 sm:grid-cols-2 md:mt-14 lg:grid-cols-5">
    {
      process.steps.map((step, i) => (
        <li class="border-t border-line pt-6">
          <span aria-hidden="true" class="block font-display text-h3 text-muted">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-4 text-h3">{step.title}</h3>
          <p class="mt-3 text-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>
