---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces/opsz.css';
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';

import Seo, { type Crumb } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props {
  title?: string;
  fullTitle?: string;
  description: string;
  noindex?: boolean;
  /** Parent pages between Home and this one, for the breadcrumb data (e.g. Services on a case study). */
  parents?: Crumb[];
}

const { title, fullTitle, description, noindex, parents } = Astro.props;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Runs before first paint: applies the stored theme, or the system one, so
      the wrong theme never flashes. Also marks JS as available. Keep the
      storage key in sync with THEME_STORAGE_KEY in src/lib/theme.ts.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var dark =
          stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.classList.toggle('dark', dark);
        root.classList.add('js');
      })();
    </script>
    <Seo title={title} fullTitle={fullTitle} description={description} noindex={noindex} parents={parents} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <!-- Headlines are usually the largest element on first view: load their face early. -->
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="generator" content={Astro.generator} />
    <!-- Page-specific head content, e.g. the Pricing page's offer-expiry check (runs before first paint). -->
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 bg-accent text-on-accent focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:px-4 focus:py-3"
      data-menu-inert
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none" data-menu-inert>
      <slot />
    </main>
    <Footer />
  </body>
</html>
