---
// About. Structure reference: narrativearcstudio.com/about-us (structure only).
// Interaction budget (CLAUDE.md): wordmark reveal, scroll reveal (incl. the
// divider draw-in), CTA marquee, node hover.
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/about/Wordmark.astro';
import MotifLink from '../components/motif/MotifLink.astro';
import NodeDivider from '../components/motif/NodeDivider.astro';
import Marquee from '../components/marquee/Marquee.astro';
import MarqueeItem from '../components/marquee/MarqueeItem.astro';
import { manifesto } from '../data/about';
import { services } from '../data/site';
import { url } from '../lib/url';

const label = 'font-body text-small font-normal text-muted';
---

<BaseLayout title="About" description="About The Connect Digital: our approach to web, social, content and app work.">
  <section class="container-site pt-16 pb-section md:pt-24" aria-labelledby="about-title">
    <Wordmark />
  </section>

  <!--
    Manifesto: a native horizontal scroll row (touch swipe, scrollbar or
    shift+wheel, arrow keys once focused), cards snap to the content edge.
    The region is focusable and named by the heading so keyboard and
    screen-reader users can reach and scroll it.
  -->
  <section class="pb-section">
    <div class="container-site">
      <h2 id="approach-title" class={label} data-reveal>Our approach</h2>
    </div>
    <div class="manifesto-scroller mt-10" role="region" aria-labelledby="approach-title" tabindex="0">
      <ol class="manifesto-track flex w-max gap-gutter">
        {
          manifesto.map((paragraph, i) => (
            <li class="manifesto-card shrink-0 border-t border-line pt-6" data-reveal>
              <span aria-hidden="true" class="block font-display text-h3 text-muted">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="mt-6 max-w-[24ch] font-display text-h2">{paragraph}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-site pb-section" aria-labelledby="what-we-do-title" data-reveal>
    <div class="grid-site gap-y-8">
      <h2 id="what-we-do-title" class:list={[label, 'col-span-4 md:col-span-2 lg:col-span-4']}>What we do</h2>
      <ul class="col-span-4 grid gap-x-gutter gap-y-6 sm:grid-cols-2 md:col-span-6 lg:col-span-7">
        {
          services.map((service) => (
            <li>
              <MotifLink href={url(`/services#${service.slug}`)} unit={2} class="font-display text-h3">
                {service.name}
              </MotifLink>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="container-site pb-section">
    <NodeDivider />
  </div>

  <section class="pb-section" aria-label="Get in touch">
    <Marquee
      label="Let's talk banner"
      href={url('/connect')}
      linkLabel="Let's talk: go to Connect page"
      speed={70}
      mobileSpeed={46}
      gap="0.35em"
      class="border-y border-line py-6 md:py-10"
    >
      <MarqueeItem class="font-display text-display">
        Let's talk <span aria-hidden="true" class="text-accent">✲</span>
      </MarqueeItem>
    </Marquee>
  </section>
</BaseLayout>

<style>
  /*
   * The row runs full width but starts and snaps at the content column's
   * left edge (the container's gutter, or more on screens wider than it).
   */
  .manifesto-scroller {
    --edge: max(var(--spacing-gutter), calc((100% - var(--container-site)) / 2 + var(--spacing-gutter)));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    padding-bottom: 1.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-accent) transparent;
  }

  .manifesto-scroller:focus-visible {
    outline-offset: -2px;
  }

  /* The track carries the edge padding, so the last card ends a gutter from the edge. */
  .manifesto-track {
    padding-inline: var(--edge);
  }

  /* Card widths as a share of the viewport (the track itself is max-content). */
  .manifesto-card {
    width: 82vw;
    scroll-snap-align: start;
  }

  @media (width >= 48rem) {
    .manifesto-card {
      width: 58vw;
    }
  }

  @media (width >= 64rem) {
    .manifesto-card {
      width: min(40vw, calc(var(--container-site) * 0.4));
    }
  }
</style>

<script>
  import { init as initHeadline } from '../lib/headline-reveal';
  import { init as initReveal } from '../lib/scroll-reveal';

  initHeadline();
  initReveal();
</script>
